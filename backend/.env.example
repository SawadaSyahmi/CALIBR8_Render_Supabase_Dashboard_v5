SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
WORKSPACE_ID=main
INGEST_API_KEY=replace-with-a-long-random-device-ingest-key
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=replace-with-fernet-key
ALLOW_DEMO=true
ALLOW_UNAUTHENTICATED_DASHBOARD=false
ALLOW_PRIVATE_API_HOSTS=false
POLL_TIMEOUT_SEC=8
MAX_EXTERNAL_RESPONSE_BYTES=5000000
