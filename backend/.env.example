SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Existing SUPABASE_ANON_KEY is accepted as an alternative.
# A Supabase service-role key is not used.
CONNECTION_ENCRYPTION_KEY=YOUR_EXISTING_FERNET_KEY
INGEST_API_KEY=YOUR_DEVICE_INGEST_KEY
ALLOW_DEMO=true
ALLOW_PRIVATE_API_HOSTS=false
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# Optional legacy three-endpoint source:
# TELEMETRY_API_URL=https://example.com/telemetry
# GPS_API_URL=https://example.com/gps
# CONTEXT_API_URL=https://example.com/context
# TELEMETRY_API_HEADERS={}
# GPS_API_HEADERS={}
# CONTEXT_API_HEADERS={}
